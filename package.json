{
  "name": "ledger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"const fs=require('fs'); const dirs=['.next/dev/server','.next/dev/server/app','.next/dev/server/pages','.next/dev/static/development','.next/cache']; dirs.forEach(d=>fs.mkdirSync(d,{recursive:true})); const mf='.next/dev/server/middleware-manifest.json'; if(!fs.existsSync(mf)) fs.writeFileSync(mf,JSON.stringify({version:2,middleware:{},sortedMiddleware:[],functions:{}}));\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "lint": "eslint",
    "test": "eslint src --max-warnings=0 && jest --passWithNoTests --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test e2e/visual.test.ts --project=chromium",
    "test:visual:update": "playwright test e2e/visual.test.ts --project=chromium --update-snapshots"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.101.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.8",
    "supabase": "^2.105.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix --max-warnings=0"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee"
}
